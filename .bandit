[bandit]
# Bandit configuration for security scanning
exclude_dirs = tests,venv,.venv,env,.env,build,dist,.git
skips = B101,B601

# Skip rules:
# B101: Test for use of assert (common in tests)
# B601: Test for shell injection within Paramiko

# Security test severity levels
# LOW: Informational findings
# MEDIUM: Potential security issues  
# HIGH: Likely security vulnerabilities

[bandit.assert_used]
skips = ['*_test.py', '*test*.py']